# Ignore all Cargo build output, including nested fixture projects
**/target/

# Editor backup and swap files
*.bak
*.orig
*.swp
*.swo
*~

# Native bindings build artifacts (bindings/python, bindings/node)
bindings/python/*.so
bindings/python/**/__pycache__/
bindings/python/.pytest_cache/
bindings/node/*.node
bindings/node/node_modules/
